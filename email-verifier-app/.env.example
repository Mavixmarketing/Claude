# =====================================================================
# COPY THIS FILE TO .env.local AND FILL IT IN
#
# .env.local must NEVER be committed to git. It is already listed in
# .gitignore - do not remove it from there.
#
# THE RULE THAT MATTERS:
#   Anything starting with NEXT_PUBLIC_ is downloaded by the visitor's
#   browser and is PUBLIC. Everything else stays on the server.
#
#   Putting a secret key in a NEXT_PUBLIC_ variable is the single most
#   common way apps like this get robbed. If you are unsure, it is not
#   NEXT_PUBLIC_.
# =====================================================================


# --- Database and login (Supabase) -----------------------------------

# Safe to be public - the browser needs these to log people in
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Full admin access to every customer's data.
# Server only. Never send this to the browser.
SUPABASE_SERVICE_ROLE_KEY=


# --- Verification suppliers ------------------------------------------
#
# These are the companies we pay per email checked.
#
# Use at least TWO. Reasons:
#   1. Consensus (the whole product) needs more than one opinion
#   2. If one goes down or cuts us off, we keep running
#
# All SECRET. Never call these from the browser - always through our
# own server, or customers can read the keys and use our credits.

PROVIDER_A_API_KEY=
PROVIDER_A_ENDPOINT=

PROVIDER_B_API_KEY=
PROVIDER_B_ENDPOINT=

PROVIDER_C_API_KEY=
PROVIDER_C_ENDPOINT=


# --- Our own SMTP node (month 6-9, not needed at launch) --------------
#
# This is the "half and half" upgrade from the plan. It drops our cost
# per email from ~$0.0005 to ~$0.0002 and lifts margins from ~45% to ~77%.
# Needs a host with port 25 open - Hetzner allows it, AWS/Google/
# Microsoft/DigitalOcean do not.

OWN_SMTP_NODE_URL=
OWN_SMTP_NODE_SECRET=


# --- Payments --------------------------------------------------------
#
# Stripe does not accept businesses based in Pakistan.
# Use a merchant of record instead: Lemon Squeezy, Polar, or Paddle.
# They handle global tax and invoicing for ~5% + $0.50.

PAYMENT_PROVIDER=lemonsqueezy
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=


# --- Our own transactional email -------------------------------------
#
# For signup confirmations and receipts.
# We are a deliverability company, so our OWN SPF, DKIM and DMARC must
# be perfect. It would be embarrassing otherwise.

RESEND_API_KEY=
FROM_EMAIL=hello@yourdomain.com


# --- Abuse prevention ------------------------------------------------

# Cloudflare Turnstile - free CAPTCHA on signup
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Free plan: 100 checks per day, no card needed, no bulk upload
FREE_PLAN_DAILY_LIMIT=100

# Alert us if free users start costing more than this per month
FREE_TIER_MONTHLY_BUDGET_USD=50
